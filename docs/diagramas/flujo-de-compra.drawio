  <diagram id="flujo-compra" name="Flujo de compra y pago">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="El comprador entra a la tienda" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Navega el catálogo&lt;br&gt;(/tienda)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="135" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Abre un producto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="¿Tiene&lt;br&gt;presentaciones?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="325" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Escoge talla,&lt;br&gt;color o sabor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="335" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Agrega al carrito&lt;br&gt;(el navegador guarda solo código y cantidad)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="440" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="El SERVIDOR recalcula el carrito&lt;br&gt;Precio y existencias reales.&lt;br&gt;Nunca los que mande el navegador." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="535" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="Checkout: datos del comprador y ciudad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="635" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="¿Se envía a&lt;br&gt;esa ciudad?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="730" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="Se avisa que todavía&lt;br&gt;no hay cobertura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="740" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="Se crea el pedido en BORRADOR&lt;br&gt;y un intento de pago en PENDING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="845" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="Se firma el monto&lt;br&gt;SHA256(referencia + monto + moneda + secreto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="945" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="El comprador paga en Wompi&lt;br&gt;Nequi · PSE · Bancolombia · Tarjeta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1045" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="Wompi avisa por webhook firmado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1140" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="¿La firma&lt;br&gt;del evento&lt;br&gt;cuadra?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1235" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="Se descarta el evento&lt;br&gt;y queda registrado.&lt;br&gt;HTTP 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="1247" width="190" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="¿El monto pagado&lt;br&gt;coincide con el pedido?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1360" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="No se confirma.&lt;br&gt;Queda registrado&lt;br&gt;para revisar a mano" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="1372" width="190" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="¿Ya se había&lt;br&gt;procesado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1485" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="Se responde 200&lt;br&gt;sin hacer nada otra vez" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="1497" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="¿El pago fue&lt;br&gt;aprobado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1605" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="El borrador queda ahí.&lt;br&gt;El comprador puede&lt;br&gt;reintentar el pago" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="1617" width="190" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="Se confirma el pedido&lt;br&gt;Se descuenta el inventario&lt;br&gt;Se registra el ingreso&lt;br&gt;Se le avisa al comprador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1730" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="Pedido listo para despachar" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1855" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n49" value="Lo que el navegador guarda es solo qué producto y cuántas unidades.&lt;br&gt;No hay ningún precio que se pueda manipular desde la consola." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=16;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="480" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="Aquí está el punto crítico de todo el diseño:&lt;br&gt;el pedido SOLO se confirma con el webhook firmado.&lt;br&gt;El regreso del comprador a la página de gracias&lt;br&gt;no prueba nada: esa URL se escribe a mano." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=16;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="1320" width="250" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n51" value="Wompi reintenta hasta 3 veces en 24 horas.&lt;br&gt;Por eso el webhook tiene que poder recibir&lt;br&gt;el mismo evento dos veces sin cobrar dos veces." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=16;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="1660" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="Quién hace qué" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
