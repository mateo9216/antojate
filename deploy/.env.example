# Copiá este archivo a .env y ajustá lo que necesites.
#   cp .env.example .env

# --- Sitio ---------------------------------------------------------------
# .localhost resuelve solo en el navegador, sin tocar /etc/hosts.
SITE_NAME=antojate.localhost
HTTP_PORT=8080
ADMIN_PASSWORD=admin

# --- Imágenes ------------------------------------------------------------
ERPNEXT_VERSION=v16.17.0
ANTOJATE_IMAGE=antojate/erpnext:v16.17.0

# --- Base de datos -------------------------------------------------------
# Local nada más. Al pasar a un servidor real, cambiala por una fuerte.
DB_ROOT_PASSWORD=admin

# --- Wompi (pasarela de pagos) -------------------------------------------
# NO se ponen aquí: se cargan en el doctype "Wompi Settings" dentro de la app,
# donde el campo privado queda cifrado en la base de datos. Este bloque queda
# como recordatorio de las cuatro llaves que entrega Wompi.
#   WOMPI_PUBLIC_KEY      pub_test_xxx / pub_prod_xxx
#   WOMPI_PRIVATE_KEY     prv_test_xxx / prv_prod_xxx
#   WOMPI_INTEGRITY_KEY   firma del checkout
#   WOMPI_EVENTS_KEY      validación del webhook
