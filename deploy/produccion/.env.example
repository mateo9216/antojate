# Configuración de PRODUCCIÓN. Copiar a .env y completar.
#
#   cp .env.example .env
#
# Este archivo NO va al repositorio (está en .gitignore). Si alguna vez se
# sube por error, hay que rotar TODAS las contraseñas: quedan en el historial
# de git para siempre, aunque después se borre el archivo.

# --- Dominio -------------------------------------------------------------
# El dominio real, ya apuntando por DNS a la IP de este servidor.
# Tiene que coincidir con el nombre del sitio de Frappe.
DOMINIO=antojate.co

# Correo al que Let's Encrypt avisa si un certificado va a vencer sin renovar.
CORREO_TLS=tecnologia@avantive.co

# --- Imagen --------------------------------------------------------------
ERPNEXT_VERSION=v16.17.0
ANTOJATE_IMAGE=antojate/erpnext:v16.17.0

# --- Contraseñas ---------------------------------------------------------
# Generar cada una con:  openssl rand -base64 24
# No reutilizar las de desarrollo. No compartirlas por WhatsApp ni por correo.
DB_ROOT_PASSWORD=
ADMIN_PASSWORD=

# --- Rendimiento ---------------------------------------------------------
# Regla práctica: (2 × núcleos) + 1. Con 2 núcleos, 5.
# Cada worker consume memoria: subirlo sin RAM suficiente empeora las cosas.
GUNICORN_WORKERS=2
